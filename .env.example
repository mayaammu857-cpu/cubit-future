# ==============================================================================
# CUBIT FUTURE ACADEMY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Backend API Base URL (FastAPI Gateway)
# Default local development port is 8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 2. Supabase / PostgreSQL Authentication Configuration (If Configured)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 3. Google Sheets Integration API Endpoint (FastAPI Proxy)
# NOTE: Never expose Google Cloud service account keys in frontend code.
# The backend FastAPI handles Google Sheets API v4 server-side authentication.
VITE_ENABLE_GOOGLE_SHEETS_PROXY=true

# 4. Academy Portal Configuration
VITE_APP_NAME="Cubit Future Academy"
VITE_ACADEMY_CODE="CF-ACADEMY-2026"
VITE_SUPPORT_EMAIL="support@cubitfuture.com"
